{
  "id": "com.thomastorp.withings-sleep",
  "version": "1.7.0",
  "compatibility": ">=12.2.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Withings Sleep",
    "no": "Withings Sleep"
  },
  "description": {
    "en": "Let your home react when you get into bed and when you get up.",
    "no": "La hjemmet reagere når du legger deg og når du står opp."
  },
  "category": [
    "security"
  ],
  "brandColor": "#00857C",
  "tags": {
    "en": [
      "withings",
      "sleep",
      "sleep analyzer",
      "bed",
      "presence",
      "bed sensor",
      "sleep tracking"
    ],
    "no": [
      "withings",
      "søvn",
      "sleep analyzer",
      "seng",
      "tilstedeværelse",
      "sengesensor",
      "søvnmåling"
    ]
  },
  "permissions": [],
  "api": {
    "getIdentity": {
      "method": "GET",
      "path": "/identity"
    },
    "testCredentials": {
      "method": "POST",
      "path": "/testCredentials"
    }
  },
  "author": {
    "name": "Thomas Torp",
    "email": "torp93@users.noreply.github.com"
  },
  "contributors": {
    "developers": [
      {
        "name": "Thomas Torp",
        "email": "torp93@users.noreply.github.com"
      }
    ]
  },
  "source": "https://github.com/torp93/homey-withings-sleep",
  "homepage": "https://github.com/torp93/homey-withings-sleep",
  "support": "https://github.com/torp93/homey-withings-sleep/issues",
  "bugs": {
    "url": "https://github.com/torp93/homey-withings-sleep/issues"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "capabilities": {
    "withings_in_bed": {
      "type": "boolean",
      "title": {
        "en": "In bed",
        "no": "I sengen"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/capability-icons/in-bed.svg"
    },
    "withings_subscription_ok": {
      "type": "boolean",
      "title": {
        "en": "Notifications active",
        "no": "Varsling aktiv"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/capability-icons/notifications.svg"
    },
    "withings_time_in_bed": {
      "type": "number",
      "title": {
        "en": "Time in bed",
        "no": "Tid i sengen"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "units": {
        "en": "min",
        "no": "min"
      },
      "decimals": 0,
      "min": 0,
      "icon": "/assets/capability-icons/time-in-bed.svg"
    },
    "withings_time_out_of_bed": {
      "type": "number",
      "title": {
        "en": "Time out of bed",
        "no": "Tid ute av sengen"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "units": {
        "en": "min",
        "no": "min"
      },
      "decimals": 0,
      "min": 0,
      "icon": "/assets/capability-icons/time-out-of-bed.svg"
    },
    "withings_last_sleep_duration": {
      "type": "number",
      "title": {
        "en": "Last night in bed",
        "no": "Siste natt i sengen"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "units": {
        "en": "min",
        "no": "min"
      },
      "decimals": 0,
      "min": 0,
      "icon": "/assets/capability-icons/last-night.svg"
    },
    "withings_bedtime": {
      "type": "string",
      "title": {
        "en": "Bedtime",
        "no": "Leggetid"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capability-icons/bedtime.svg"
    },
    "withings_wakeup_time": {
      "type": "string",
      "title": {
        "en": "Got up",
        "no": "Stod opp"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capability-icons/wakeup.svg"
    },
    "withings_time_in_bed_text": {
      "type": "string",
      "title": {
        "en": "Time in bed, readable",
        "no": "Tid i sengen, lesbar"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capability-icons/time-in-bed.svg"
    },
    "withings_time_out_of_bed_text": {
      "type": "string",
      "title": {
        "en": "Time out of bed, readable",
        "no": "Tid ute av sengen, lesbar"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capability-icons/time-out-of-bed.svg"
    },
    "withings_last_sleep_text": {
      "type": "string",
      "title": {
        "en": "Last night in bed, readable",
        "no": "Siste natt i sengen, lesbar"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capability-icons/last-night.svg"
    },
    "withings_sleep_score": {
      "type": "number",
      "title": {
        "en": "Sleep score",
        "no": "Søvnscore"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "decimals": 0,
      "min": 0,
      "icon": "/assets/capability-icons/last-night.svg"
    },
    "withings_heart_rate": {
      "type": "number",
      "title": {
        "en": "Heart rate, night average",
        "no": "Puls, snitt for natten"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "units": {
        "en": "bpm",
        "no": "slag/min"
      },
      "decimals": 0,
      "min": 0,
      "icon": "/assets/capability-icons/bedtime.svg"
    },
    "withings_breathing_rate": {
      "type": "number",
      "title": {
        "en": "Breathing rate, night average",
        "no": "Pustefrekvens, snitt for natten"
      },
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "units": {
        "en": "br/min",
        "no": "pust/min"
      },
      "decimals": 0,
      "min": 0,
      "icon": "/assets/capability-icons/wakeup.svg"
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "withings_bed_in",
        "title": {
          "en": "Someone gets into bed",
          "no": "Noen legger seg i sengen"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=sleep_analyzer"
          }
        ]
      },
      {
        "id": "withings_bed_out",
        "title": {
          "en": "Someone gets out of bed",
          "no": "Noen står opp av sengen"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=sleep_analyzer"
          }
        ]
      },
      {
        "id": "withings_subscription_lost",
        "title": {
          "en": "The Withings notification subscription is lost",
          "no": "Withings-varslingsabonnementet mistes"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=sleep_analyzer"
          }
        ]
      },
      {
        "id": "withings_summary_ready",
        "title": {
          "en": "A new sleep summary is available",
          "no": "En ny søvnoppsummering er klar"
        },
        "hint": {
          "en": "Runs when Withings has finished scoring a night, which is usually a while after you get up. The tokens carry last night's numbers.",
          "no": "Kjører når Withings er ferdig med å score en natt, som regel en stund etter at du står opp. Kortet gir deg tallene for natten."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=sleep_analyzer"
          }
        ],
        "tokens": [
          {
            "name": "minutes",
            "type": "number",
            "title": {
              "en": "Minutes in bed",
              "no": "Minutter i sengen"
            }
          },
          {
            "name": "readable",
            "type": "string",
            "title": {
              "en": "Time in bed",
              "no": "Tid i sengen"
            }
          },
          {
            "name": "score",
            "type": "number",
            "title": {
              "en": "Sleep score",
              "no": "Søvnscore"
            }
          },
          {
            "name": "heart_rate",
            "type": "number",
            "title": {
              "en": "Heart rate",
              "no": "Puls"
            }
          },
          {
            "name": "breathing_rate",
            "type": "number",
            "title": {
              "en": "Breathing rate",
              "no": "Pustefrekvens"
            }
          }
        ]
      },
      {
        "id": "withings_reauthorize_needed",
        "title": {
          "en": "The Withings connection needs authorizing again",
          "no": "Withings-tilkoblingen må godkjennes på nytt"
        },
        "hint": {
          "en": "Runs when Withings refuses the stored login and the device can no longer fetch data. Use it to send yourself a notification instead of finding out when a Flow does not run.",
          "no": "Kjører når Withings avviser den lagrede innloggingen og enheten ikke lenger kan hente data. Bruk det til å varsle deg selv, i stedet for å oppdage det når en flyt ikke kjørte."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=sleep_analyzer"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "withings_is_in_bed",
        "title": {
          "en": "Someone !{{is|isn't}} in bed",
          "no": "Noen !{{er|er ikke}} i sengen"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=sleep_analyzer"
          }
        ]
      },
      {
        "id": "withings_in_bed_longer_than",
        "title": {
          "en": "Time in bed !{{is|is not}} more than",
          "no": "Tid i sengen !{{er|er ikke}} mer enn"
        },
        "titleFormatted": {
          "en": "Time in bed !{{is|is not}} more than [[minutes]] min",
          "no": "Tid i sengen !{{er|er ikke}} mer enn [[minutes]] min"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=sleep_analyzer"
          },
          {
            "name": "minutes",
            "type": "number",
            "min": 1,
            "max": 1440,
            "step": 1,
            "placeholder": {
              "en": "Minutes",
              "no": "Minutter"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "withings_resubscribe",
        "title": {
          "en": "Renew the Withings notification subscription",
          "no": "Forny Withings-varslingsabonnementet"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=sleep_analyzer"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "sleep_analyzer",
      "name": {
        "en": "Sleep Analyzer",
        "no": "Sleep Analyzer"
      },
      "class": "sensor",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "capabilities": [
        "withings_in_bed",
        "withings_bedtime",
        "withings_wakeup_time",
        "withings_time_in_bed",
        "withings_time_out_of_bed",
        "withings_last_sleep_duration",
        "withings_subscription_ok",
        "withings_time_in_bed_text",
        "withings_time_out_of_bed_text",
        "withings_last_sleep_text",
        "withings_sleep_score",
        "withings_heart_rate",
        "withings_breathing_rate"
      ],
      "capabilitiesOptions": {
        "withings_in_bed": {
          "titleTrue": {
            "en": "In bed",
            "no": "I sengen"
          },
          "titleFalse": {
            "en": "Out of bed",
            "no": "Ute av sengen"
          }
        },
        "withings_subscription_ok": {
          "titleTrue": {
            "en": "Active",
            "no": "Aktiv"
          },
          "titleFalse": {
            "en": "Lost",
            "no": "Mistet"
          }
        }
      },
      "pair": [
        {
          "id": "start",
          "navigation": {
            "next": "list_devices"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "poll_interval_seconds",
          "type": "number",
          "label": {
            "en": "Polling interval",
            "no": "Pollingintervall"
          },
          "hint": {
            "en": "How often the app asks Withings for the current bed state, 60 seconds by default. Withings does not publish a live sleep series for every mat: if yours stays empty, polling cannot detect bed presence at all, and the webhook is what makes the app work. Set one up under Settings, Show app, Settings, App settings, where the guide walks through it. Set to 0 to turn polling off.",
            "no": "Hvor ofte appen spør Withings om sengetilstanden, som standard hvert 60. sekund. Withings publiserer ikke en løpende søvnserie for alle matter: er din tom, kan ikke polling oppdage sengetilstedeværelse i det hele tatt, og da er webhooken det som får appen til å virke. Den settes opp under Innstillinger, Vis app, Innstillinger, Appinnstillinger, der veiledningen tar deg gjennom det. Sett til 0 for å slå av polling."
          },
          "value": 60,
          "min": 0,
          "max": 3600,
          "step": 10,
          "units": {
            "en": "s",
            "no": "s"
          }
        },
        {
          "id": "bed_freshness_seconds",
          "type": "number",
          "label": {
            "en": "Bed presence window",
            "no": "Vindu for sengetilstedeværelse"
          },
          "hint": {
            "en": "How recent the sleep data must be for the bed to count as occupied. Withings is often a few minutes behind, so a short window can report an empty bed while you are lying in it. Leave this at 300 unless you know your mat updates faster.",
            "no": "Hvor ferske søvndataene må være for at sengen skal regnes som opptatt. Withings ligger ofte noen minutter etter, så et kort vindu kan melde tom seng mens du ligger i den. La denne stå på 300 med mindre du vet at matta di oppdaterer raskere."
          },
          "value": 300,
          "min": 60,
          "max": 1800,
          "step": 30,
          "units": {
            "en": "s",
            "no": "s"
          }
        },
        {
          "id": "resubscribe_hours",
          "type": "number",
          "label": {
            "en": "Subscription check interval",
            "no": "Intervall for abonnementssjekk"
          },
          "hint": {
            "en": "How often to verify the bed-in and bed-out subscriptions still exist at Withings, and recreate them if not.",
            "no": "Hvor ofte abonnementene for seng inn og seng ut verifiseres hos Withings, og gjenopprettes hvis de mangler."
          },
          "value": 6,
          "min": 1,
          "max": 168,
          "step": 1,
          "units": {
            "en": "h",
            "no": "t"
          }
        },
        {
          "id": "maintenance",
          "type": "group",
          "label": {
            "en": "Maintenance",
            "no": "Vedlikehold"
          },
          "children": [
            {
              "id": "refresh_now",
              "type": "checkbox",
              "value": false,
              "label": {
                "en": "Refresh status on save",
                "no": "Oppdater status ved lagring"
              },
              "hint": {
                "en": "Asks Withings for the latest completed night and corrects bedtime, wake-up and duration. If the bed still shows as occupied but Withings has since scored a finished night, the state is corrected too. Use this when an event was missed, for instance after a power cut.",
                "no": "Spør Withings om siste fullførte natt og retter leggetid, oppvåkning og varighet. Står sengen fortsatt som opptatt mens Withings har scoret en ferdig natt, rettes også tilstanden. Bruk denne når en hendelse har gått tapt, for eksempel etter strømbrudd."
              }
            },
            {
              "id": "renew_now",
              "type": "checkbox",
              "value": false,
              "label": {
                "en": "Renew subscription on save",
                "no": "Forny abonnement ved lagring"
              },
              "hint": {
                "en": "Verifies the bed-in and bed-out subscriptions at Withings and recreates any that are missing, then clears itself. Use this when Notifications shows Lost and you do not want to wait for the scheduled check.",
                "no": "Verifiserer abonnementene for seng inn og seng ut hos Withings og gjenoppretter dem som mangler, og nullstiller seg selv. Bruk denne når Varsling viser Mistet og du ikke vil vente på den planlagte sjekken."
              }
            }
          ]
        }
      ],
      "images": {
        "small": "/drivers/sleep_analyzer/assets/images/small.png",
        "large": "/drivers/sleep_analyzer/assets/images/large.png",
        "xlarge": "/drivers/sleep_analyzer/assets/images/xlarge.png"
      },
      "repair": [
        {
          "id": "repair"
        }
      ]
    }
  ],
  "contributing": {
    "donate": {
      "githubSponsors": {
        "username": "torp93"
      },
      "paypal": {
        "username": "torpthomas"
      }
    }
  }
}
